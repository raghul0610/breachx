# Server-side only. Never expose this value as VITE_*.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Used by serverless AI routes to verify user access tokens.
# Use the Supabase publishable/anon key only; never use the service_role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Required in production for shared, atomic rate limiting across serverless instances.
# Create a Redis database with Upstash and store these only as server-side deployment env vars.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional URL sent as the OpenRouter HTTP-Referer.
APP_URL=
