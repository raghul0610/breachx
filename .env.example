# Server-side only. Never expose this value as VITE_*.
OPENROUTER_API_KEY=

# Used by serverless AI routes to verify Supabase access tokens. Never use service_role here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Required in deployed environments for shared rate limiting across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Recommended for the architecture evaluator. OpenRouter routes among available models.
OPENROUTER_MODEL=openrouter/free

# Optional URL sent as the OpenRouter HTTP-Referer.
APP_URL=
